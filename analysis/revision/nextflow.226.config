// 64-core host (cuscuta226). Same pipeline, larger per-process allocations than
// the 24-core workstation config; every subsampling run uses these same numbers,
// so CPU-hours are comparable across configurations.
includeConfig '/data2/k821209/gm/gene-miner/nextflow.config'
process {
  executor = "local"
  cpus = 16
  withName: MASK_GENOME     { cpus = 24 }
  withName: BUSCO_TRAIN     { cpus = 24 }
  withName: HISAT2_BUILD    { cpus = 24 }
  withName: HISAT2_ALIGN    { cpus = 14 }
  withName: STRINGTIE       { cpus = 8  }
  withName: STRINGTIE_MERGE { cpus = 8  }
  withName: TRANSDECODER    { cpus = 24 }
  withName: AUGUSTUS_PREDICT{ cpus = 48 }
  withName: GENEMARK_ETP    { cpus = 48 }
  withName: EGGNOG          { cpus = 32 }
  withName: BUSCO           { cpus = 32 }
}
executor { cpus = 56 }
